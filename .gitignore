# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
.ENV
.env.*
.ENV.*
.DS_Store

# Data (large, downloaded or regenerated by the notebooks)
data/*
# Except the trained hotspot model the API loads (HOTSPOT_MODEL_DIR). Git cannot re-include a file
# inside an ignored folder, so each parent folder is re-included and its other contents ignored again.
!data/models/
data/models/*
!data/models/hotspots/
data/models/hotspots/*
!data/models/hotspots/Maule/
data/models/hotspots/Maule/*
!data/models/hotspots/Maule/model.json
!data/models/hotspots/Maule/metadata.json